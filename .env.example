# SmartLMS Frontend Environment Configuration

# Backend API base URL (must include /api)
# For local development:
# VITE_API_BASE_URL=http://localhost:8008/api

# For production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com/api
